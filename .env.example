# Bwell's JFrog Creds (get your token from https://artifacts.bwell.com/ -> Edit Profile -> Identity Tokens)
JFROG_READ_USER=your_email@bwell.zone
JFROG_READ_TOKEN=your_jfrog_identity_token

# uv index auth -- used directly by `uv lock`/`uv sync` outside Docker; the Dockerfile
# builds these from the jfrog_read_user/jfrog_read_token secrets instead. Must match
# JFROG_READ_USER above, not be left blank -- Artifactory's virtual-pypi rejects an empty
# username with 403 even given a valid token as the password.
UV_INDEX_JFROG_USERNAME=your_email@bwell.zone
UV_INDEX_JFROG_PASSWORD=your_jfrog_identity_token

# Candidate-cache source. Unset -> the service still starts, but the cache stays
# empty and every $match request returns no_match. See docs/TECH_DESIGN.md Open
# Question 4 -- which FHIR server backs this per environment is not yet decided.
# FHIR_BASE_URL=https://fhir.dev.icanbwell.com
# FHIR_TOKEN_URL=
# FHIR_CLIENT_ID=
# FHIR_CLIENT_SECRET=
# CACHE_DATABASE_PATH=:memory:
# CACHE_REFRESH_INTERVAL_MINUTES=60

# Bearer-JWT auth for POST /Patient/$match. Unset -> fails closed (401 on every
# request to that route), not open.
# AUTH_JWK_URLS=
# AUTH_EXPECTED_CIDS=
# AUTH_CID_CHECK_ISSUER=
# AUTH_JWKS_CACHE_TTL_SECONDS=300

# Unauthenticated manual-testing UI at /testing-ui (decode an IAL2 token, or
# compare two pasted FHIR Patients). Unset by default -- never set this in a
# production or externally-reachable deployment.
# ENABLE_TESTING_UI=true
